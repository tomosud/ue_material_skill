 "Custom": {
  "class": "/Script/Engine.UMaterialExpressionCustom",
  "header": "Materials/MaterialExpressionCustom.h",
  "desc": "Embeds user HLSL in a generated material function with property-defined dynamic inputs and outputs.",
  "inputs": [],
  "prop_pins": [],
  "outputs": [],
  "props": {
   "Code": {
    "type": "FString",
    "default": "// The below expression will get compiled\n// into the output of this node\nfloat3(1, 1, 1)"
   },
   "Description": {
    "type": "FString",
    "default": "Custom"
   },
   "OutputType": {
    "type": "enum:ECustomMaterialOutputType",
    "default": "CMOT_Float3",
    "choices": [
     "CMOT_Float1",
     "CMOT_Float2",
     "CMOT_Float3",
     "CMOT_Float4",
     "CMOT_MaterialAttributes"
    ]
   },
   "Inputs": {
    "type": "TArray<FCustomInput>",
    "default": [
     {
      "InputName": ""
     }
    ],
    "struct": {
     "InputName": {
      "type": "FName",
      "default": ""
     }
    }
   },
   "AdditionalOutputs": {
    "type": "TArray<FCustomOutput>",
    "default": [],
    "struct": {
     "OutputName": {
      "type": "FName",
      "default": ""
     },
     "OutputType": {
      "type": "enum:ECustomMaterialOutputType",
      "default": "CMOT_Float1",
      "choices": [
       "CMOT_Float1",
       "CMOT_Float2",
       "CMOT_Float3",
       "CMOT_Float4",
       "CMOT_MaterialAttributes"
      ]
     }
    }
   },
   "AdditionalDefines": {
    "type": "TArray<FCustomDefine>",
    "default": [],
    "struct": {
     "DefineName": {
      "type": "FString",
      "default": ""
     },
     "DefineValue": {
      "type": "FString",
      "default": ""
     }
    }
   },
   "IncludeFilePaths": {
    "type": "TArray<FString>",
    "default": []
   },
   "ContainsClipInstruction": {
    "type": "enum:ECustomMaterialClipInstruction",
    "default": "CMCI_Search",
    "choices": [
     "CMCI_Search",
     "CMCI_Yes",
     "CMCI_No"
    ]
   },
   "ShowCode": {
    "type": "bool",
    "default": false
   }
  },
  "notes": "Inputs and outputs are dynamic. RebuildOutputs creates one unnamed output without AdditionalOutputs, otherwise 'return' followed by named outputs. Pin LinkedTo records own connections; FCustomInput.Input is reconstructed. UE 5.8 defaults are Description='Custom', OutputType=CMOT_Float3, and one unnamed input. Material IR permits at most 32 named inputs plus named additional outputs. The LumaSplit fixture has generated paste/copy-back evidence.",
  "dynamic_pins": true
 },
