        "prop": "SamplerSource",
        "kind": "Advanced",
        "type": "enum:ESamplerSourceMode"
      }
    ],
    "outputs": [
      {
        "name": "RGB",
        "mask": "RGB"
      },
      {
        "name": "R",
        "mask": "R"
      },
      {
        "name": "G",
        "mask": "G"
      },
      {
        "name": "B",
        "mask": "B"
      },
      {
        "name": "A",
        "mask": "A"
      },
      {
        "name": "RGBA",
        "mask": "RGBA"
      }
    ],
    "props": {
      "Texture": {
        "type": "asset:UTexture",
        "default": null
      },
      "SamplerType": {
        "type": "enum:EMaterialSamplerType",
        "default": "SAMPLERTYPE_Color"
      },
      "ConstCoordinate": {
        "type": "uint32",
        "default": 0
